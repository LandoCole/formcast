  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.org/schemas/employee-federal-withholding.json",
    "title": "Employee federal withholding",
    "description": "Payroll record of an employee's federal income tax withholding elections.",
    "type": "object",
    "properties": {
      "employee_id": {
        "type": "string",
        "description": "Payroll employee number."
      },
      "employee": {
        "type": "object",
        "properties": {
