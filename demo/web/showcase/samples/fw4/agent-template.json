            "type": "boolean",
            "description": "Step 2(c): exactly two jobs in the household, box checked on both."
          },
          "dependent_credits": {
            "type": "number",
            "minimum": 0,
            "description": "Step 3 total credit amount, in dollars."
          },
          "other_income": {
            "type": "number",
            "minimum": 0,
            "description": "Step 4(a): other annual income not from jobs."
          },
          "deductions": {
            "type": "number",
            "minimum": 0,
            "description": "Step 4(b): deductions beyond the standard deduction."
          },
          "extra_withholding": {
            "type": "number",
            "minimum": 0,
            "description": "Step 4(c): extra tax withheld each pay period."
          },
          "exempt": {
            "type": "boolean",
            "description": "Claims exemption from withholding."
          },
          "effective_date": {
            "type": "string",
            "format": "date",
            "description": "First payroll the elections apply to."
          }
        },
        "required": [
          "filing_status"
        ]
      },
      "employer": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "$ref": "#/$defs/address"
          },
          "ein": {
            "type": "string",
            "pattern": "^\\d{2}-\\d{7}$",
            "description": "Formatted NN-NNNNNNN."
          }
        }
      },
      "hire_date": {
        "type": "string",
        "format": "date"
      },
      "signed_on": {
        "type": "string",
        "format": "date"
      }
    },
    "required": [
